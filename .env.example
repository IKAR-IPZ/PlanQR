# PlanQR environment template.
# Copy this file to `.env` and adjust values for your machine/server.
# Keep `.env` private; do not commit real secrets, passwords, tokens, or production URLs.

# Runtime mode for the backend. Allowed values: development, production, test.
NODE_ENV=development

# Backend HTTP/HTTPS port. The Docker setup expects 9099 unless you also update port mappings.
PORT=9099

# true = backend serves plain HTTP. false = backend expects certs/cert.pem and certs/cert.key.
DISABLE_HTTPS=true

# Development only. true bypasses LDAP login and is rejected unless NODE_ENV=development.
DEV_AUTH_BYPASS=false

# Public backend URL visible from the browser. Do not append /api.
BACKEND_PUBLIC_URL=http://localhost:9099

# Allowed frontend origins for CORS. Use comma-separated origins or * for all origins.
CORS_ORIGIN=http://localhost:3000,https://localhost:3000,https://localhost

# PostgreSQL connection string used by Prisma/backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planqr_db?schema=public

# JWT signing secret. Replace with a long random value before running outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Optional root admin account stored in env. Leave both blank to disable.
# If one is set, the other must also be set.
ROOT_ADMIN_LOGIN=
ROOT_ADMIN_PASSWORD=

# LDAP server URL and DN pattern. `%s` is replaced with the submitted login.
LDAP_URL=ldap://ldap.zut.edu.pl
LDAP_DN=uid=%s,cn=users,cn=accounts,dc=zut,dc=edu,dc=pl

# Optional LDAP user cache synchronization.
# true runs sync at backend startup and then periodically.
LDAP_SYNC_ENABLED=false

# all = sync all matching LDAP users; known = sync only logins already known by the app.
LDAP_SYNC_MODE=all

# LDAP search base for sync. If empty, backend derives it from LDAP_DN.
LDAP_SYNC_SEARCH_BASE_DN=cn=users,cn=accounts,dc=zut,dc=edu,dc=pl

# LDAP filter used when LDAP_SYNC_MODE=all.
LDAP_SYNC_FULL_FILTER=(uid=*)

# Full-sync page size. Maximum accepted value is 1000.
LDAP_SYNC_FULL_PAGE_SIZE=500

# Full-sync user limit. 0 means no limit.
LDAP_SYNC_FULL_USER_LIMIT=0

# Maximum number of known logins processed in LDAP_SYNC_MODE=known.
LDAP_SYNC_KNOWN_USER_LIMIT=2000

# Number of LDAP lookups per batch in known mode. Maximum accepted value is 100.
LDAP_SYNC_BATCH_SIZE=50

# Optional bearer token for external worker access to protected attendance endpoints.
# Leave blank to disable token-based worker access.
WORKER_SECRET_TOKEN=

# Frontend dev server port used by Vite.
FRONTEND_DEV_PORT=3000

# Public frontend URL used by Vite/HMR during local development.
# Use https://localhost:3000 only when certs/cert.pem and certs/cert.key exist.
FRONTEND_PUBLIC_URL=http://localhost:3000

# Host port mapped to the frontend nginx container's HTTPS port 443.
FRONTEND_PORT=443

# Backend URL visible from the frontend nginx container.
# Use http://backend:9099 with the root docker-compose.yml stack.
BACKEND_INTERNAL_URL=http://backend:9099

# ZUT schedule endpoints proxied by the frontend and used by the backend.
ZUT_SCHEDULE_STUDENT_URL=https://plan.zut.edu.pl/schedule_student.php
ZUT_SCHEDULE_URL=https://plan.zut.edu.pl/schedule.php

# Base URL used by frontend links and QR codes.
ZUT_PLAN_BASE_URL=https://plan.zut.edu.pl
